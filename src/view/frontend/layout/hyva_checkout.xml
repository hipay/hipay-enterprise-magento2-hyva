<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="HiPay_FullserviceMagento::css/hipay.css"/>
        <css src="HiPay_FullserviceMagento::css/hosted-fields.css"/>
    </head>
    <body>
        <referenceBlock name="content">
            <block class="HiPay\FullserviceMagento\Block\ExternalJS"
                   name="hipay_fingerprint_field"
                   ifconfig="hipay/configurations/fingerprint_enabled"
                   template="additional/fingerprint_field.phtml"/>
        </referenceBlock>
        <referenceBlock name="head.additional">
            <block class="HiPay\FullserviceMagento\Block\ExternalJS"
                   name="hipay_fingerprint_js"
                   ifconfig="hipay/configurations/fingerprint_enabled"
                   template="additional/fingerprint_js.phtml"/>
        </referenceBlock>
        <referenceBlock name="head.additional">
            <block class="HiPay\FullserviceMagento\Block\ExternalJS"
                   name="hipay_external_js"
                   template="additional/external_js.phtml"/>
        </referenceBlock>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.hipay_alma3X"
                   as="hipay_alma3X"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_page.phtml" />
            <block name="checkout.payment.method.hipay_alma4X"
                   as="hipay_alma4X"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_page.phtml" />
            <block name="checkout.payment.method.hipay_ideal"
                   as="hipay_ideal"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_page.phtml" />
            <block name="checkout.payment.method.hipay_mbway"
                   as="hipay_mbway"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_page.phtml" />
            <block name="checkout.payment.method.hipay_przelewy24api"
                   as="hipay_przelewy24api"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_page.phtml" />
            <block name="checkout.payment.method.hipay_mybank"
                   as="hipay_mybank"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_page.phtml" />
            <block name="checkout.payment.method.hipay_multibanco"
                   as="hipay_multibanco"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_iframe.phtml">
                <arguments>
                    <argument name="method_code" xsi:type="string">hipay_multibanco</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_applepay"
                   as="hipay_applepay"
                   template="HiPay_FullserviceHyvaCheckout::magewire/applepay.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\ApplePayMethod
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_hosted"
                   as="hipay_hosted"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\CardMethod
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_hosted_fields"
                   as="hipay_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\CardMethod
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_paypalapi"
                   as="hipay_paypalapi"
                   template="HiPay_FullserviceHyvaCheckout::magewire/paypalapi.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\PayPalMethod
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_ideal_hosted_fields"
                   as="hipay_ideal_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/local_hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod
                    </argument>
                    <argument name="method_code" xsi:type="string">hipay_ideal_hosted_fields</argument>
                    <argument name="product_code" xsi:type="string">ideal</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_bancontact_hosted_fields"
                   as="hipay_bancontact_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/local_hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod
                    </argument>
                    <argument name="method_code" xsi:type="string">hipay_bancontact_hosted_fields</argument>
                    <argument name="product_code" xsi:type="string">bancontact</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_multibanco_hosted_fields"
                   as="hipay_multibanco_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/local_hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod
                    </argument>
                    <argument name="method_code" xsi:type="string">hipay_multibanco_hosted_fields</argument>
                    <argument name="product_code" xsi:type="string">multibanco</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_mbway_hosted_fields"
                   as="hipay_mbway_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/local_hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod
                    </argument>
                    <argument name="method_code" xsi:type="string">hipay_mbway_hosted_fields</argument>
                    <argument name="product_code" xsi:type="string">mbway</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_bizum_hosted_fields"
                   as="hipay_bizum_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/local_hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod
                    </argument>
                    <argument name="method_code" xsi:type="string">hipay_bizum_hosted_fields</argument>
                    <argument name="product_code" xsi:type="string">bizum</argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.hipay_bancomatpay_hosted_fields"
                   as="hipay_bancomatpay_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::magewire/local_hosted_fields.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        \HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod
                    </argument>
                    <argument name="method_code" xsi:type="string">hipay_bancomatpay_hosted_fields</argument>
                    <argument name="product_code" xsi:type="string">bancomatpay</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceContainer name="magewire.plugin.scripts">
            <block name="hipay.checkout.csp.form_helper"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/payment-form-helper-csp.phtml"/>
            <block name="hipay.checkout.csp.payment_bus"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/payment-method-bus-csp.phtml"/>
            <block name="hipay.checkout.csp.paypalapi"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/paypalapi-csp.phtml"/>
            <block name="hipay.checkout.csp.applepay"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/applepay-csp.phtml"/>
            <block name="hipay.checkout.csp.hosted"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/hosted-csp.phtml"/>
            <block name="hipay.checkout.csp.hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/hosted-fields-csp.phtml"
            />
            <block name="hipay.checkout.csp.local_hosted_fields"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/local-hosted-fields-csp.phtml"
            />
            <block name="hipay.checkout.csp.hosted_iframe"
                   template="HiPay_FullserviceHyvaCheckout::checkout/payment/hosted-iframe-csp.phtml"
            />
        </referenceContainer>
    </body>
</page>
