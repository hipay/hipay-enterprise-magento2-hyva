declare(strict_types=1);

use HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod;
use HiPay\FullserviceHyvaCheckout\ViewModel\Config;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;

/** @var ViewModelRegistry $viewModels */
/** @var HostedFieldsLocalMethod $magewire */
/** @var Escaper $escaper */
/** @var \Magento\Framework\View\Element\Template $block */

$configViewModel = $viewModels->require(Config::class);
$methodCode = (string) $block->getData('method_code');
$productCode = (string) $block->getData('product_code');

// async methods needing a mobile-app confirmation show an informative note
$informativeMessages = [
    'bizum' => __('The payment will have to be validated on your Bizum application.'),
    'bancomatpay' => __('The payment will have to be validated on your Bancomat Pay application.'),
];
$informativeMessage = $informativeMessages[$productCode] ?? null;

// phone widgets (mbway, bizum, bancomatpay): top spacing so the floating label doesn't overlap the title
$containerStyle = in_array($productCode, ['mbway', 'bizum', 'bancomatpay'], true) ? 'padding-top: 1.25rem;' : '';
?>
<div
    x-data="hipayCheckoutLocalHostedFields"
    data-method="<?= $escaper->escapeHtmlAttr($methodCode) ?>"
    data-product="<?= $escaper->escapeHtmlAttr($productCode) ?>"
    data-wire-id="<?= $escaper->escapeHtmlAttr($magewire->getId()) ?>"
    data-local-config="<?= $escaper->escapeHtmlAttr($configViewModel->getSerializedLocalConfig()) ?>"
    data-general-config="<?= $escaper->escapeHtmlAttr($configViewModel->getSerializedConfig()) ?>"
>
    <div
        id="hipay-container-hosted-fields-<?= $escaper->escapeHtmlAttr($productCode) ?>"
        class="bg-white !w-full"
        <?php if ($containerStyle): ?>style="<?= $escaper->escapeHtmlAttr($containerStyle) ?>"<?php endif; ?>
        wire:ignore
    ></div>
    <?php if ($informativeMessage): ?>
        <div class="information-message mt-2 text-sm text-gray-600">
            <?= $escaper->escapeHtml($informativeMessage) ?>
        </div>
    <?php endif; ?>
</div>
