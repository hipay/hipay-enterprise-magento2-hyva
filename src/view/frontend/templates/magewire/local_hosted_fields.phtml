declare(strict_types=1);

use HiPay\FullserviceHyvaCheckout\Magewire\HostedFieldsLocalMethod;
use HiPay\FullserviceHyvaCheckout\ViewModel\Config;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;

/** @var ViewModelRegistry $viewModels */
/** @var HostedFieldsLocalMethod $magewire */
/** @var Escaper $escaper */
/** @var \Magento\Framework\View\Element\Template $block */

$configViewModel = $viewModels->require(Config::class);
$methodCode = (string) $block->getData('method_code');
$productCode = (string) $block->getData('product_code');

// mbway's floating phone label needs top spacing so it doesn't overlap the method title
$containerStyle = $productCode === 'mbway' ? 'padding-top: 1.25rem;' : '';
?>
<div
    x-data="hipayCheckoutLocalHostedFields"
    data-method="<?= $escaper->escapeHtmlAttr($methodCode) ?>"
    data-product="<?= $escaper->escapeHtmlAttr($productCode) ?>"
    data-wire-id="<?= $escaper->escapeHtmlAttr($magewire->getId()) ?>"
    data-local-config="<?= $escaper->escapeHtmlAttr($configViewModel->getSerializedLocalConfig()) ?>"
    data-general-config="<?= $escaper->escapeHtmlAttr($configViewModel->getSerializedConfig()) ?>"
>
    <div
        id="hipay-container-hosted-fields-<?= $escaper->escapeHtmlAttr($productCode) ?>"
        class="bg-white !w-full"
        <?php if ($containerStyle): ?>style="<?= $escaper->escapeHtmlAttr($containerStyle) ?>"<?php endif; ?>
        wire:ignore
    ></div>
</div>
