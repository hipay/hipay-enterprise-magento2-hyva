declare(strict_types=1);

use HiPay\FullserviceHyvaCheckout\Magewire\ApplePayMethod;
use HiPay\FullserviceHyvaCheckout\ViewModel\Config;
use HiPay\FullserviceMagento\Model\Method\ApplePay;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;

/** @var ViewModelRegistry $viewModels */
/** @var ApplePayMethod $magewire */
/** @var Escaper $escaper */

$configViewModel    = $viewModels->require(Config::class);
$quoteInformations  = $magewire->getQuoteInformations();
?>
<div
    x-data="hipayCheckoutApplePay"
    data-method="<?= $escaper->escapeHtmlAttr(ApplePay::HIPAY_METHOD_CODE) ?>"
    data-wire-id="<?= $escaper->escapeHtmlAttr($magewire->getId()) ?>"
    data-selector-id="hipay-apple-pay-button"
    data-toc-enabled="<?= $configViewModel->isTOCEnabled() ? '1' : '0' ?>"
    data-applepay-config="<?= $escaper->escapeHtmlAttr($configViewModel->getSerializedApplePayConfig()) ?>"
    data-general-config="<?= $escaper->escapeHtmlAttr($configViewModel->getSerializedConfig()) ?>"
    data-grand-total="<?= $escaper->escapeHtmlAttr((string) ($quoteInformations['base_grand_total'] ?? '0')) ?>"
    data-country-code="<?= $escaper->escapeHtmlAttr((string) ($quoteInformations['country_id'] ?? '')) ?>"
    data-currency-code="<?= $escaper->escapeHtmlAttr((string) ($quoteInformations['currency_code'] ?? '')) ?>"
>
    <div class="hipay-field-container apple-container">
        <?php if ($configViewModel->isTOCEnabled()): ?>
            <div
                id="applepay-toc-message"
                data-role="applepay-agreements-warning"
                class="hidden mt-2 text-sm text-red-600"
                role="alert"
                aria-live="polite"
            >
                <?= $escaper->escapeHtml(__('Please agree with the terms of conditions below')) ?>
            </div>
        <?php endif; ?>

        <div
            id="applepay-required-fields-message"
            data-role="applepay-required-fields-warning"
            class="hidden mt-2 text-sm text-red-600"
            role="alert"
            aria-live="polite"
        >
            <?= $escaper->escapeHtml(__('Please complete the required fields to pay with Apple Pay.')) ?>
        </div>

        <div
            class="hipay-payment-request-button"
            id="hipay-apple-pay-button"
            wire:ignore
        ></div>

        <div class="message warning hidden" id="applepay-message">
            <div>
                <span>
                    <?= $escaper->escapeHtml(
                        __(
                            'Your browser isn\'t compatible with Apple Pay or you don\'t have credit card ' .
                            'on your device.'
                        )
                    ) ?>
                </span>
            </div>
        </div>
    </div>
</div>
