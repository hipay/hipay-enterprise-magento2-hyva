<script>
    "use strict";

    /**
     * Hosted payment renderer for Hyvä Checkout.
     */
    function hipayCheckoutHosted() {
        const methodCode = this.$el.dataset.method;
        const wireId = this.$el.dataset.wireId;

        if (!window.hipayHostedInitialized) {
            window.hipayHostedInitialized = {};
        }
        if (window.hipayHostedInitialized[wireId]) {
            return {};
        }
        window.hipayHostedInitialized[wireId] = true;

        let hiPayGeneralConfig = {};
        let hiPayCcConfig = {};

        try { hiPayGeneralConfig = JSON.parse(this.$el.dataset.generalConfig || "{}"); } catch (e) {}
        try { hiPayCcConfig = JSON.parse(this.$el.dataset.ccConfig || "{}"); } catch (e) {}

        const component = {
            afterPlaceOrderUrl: "",
            createOneclick: false,
            customerCards: [],
            isIframeMode: "",
            isInAction: false,
            iframeHeight: "",
            iframeStyle: "",
            iframeWidth: "",
            iframeWrapperStyle: "",
            env: this.$el.dataset.apiEnv || "",
            apiUsernameTokenJs: this.$el.dataset.apiUsernameTokenJs || "",
            apiPasswordTokenJs: this.$el.dataset.apiPasswordTokenJs || "",
            locale: ""
        };

        const selectors = {};

        let hyvaRegistered = false;

        // Cache all DOM nodes used by this payment renderer.
        function initSelectors(rootEl) {
            selectors.rootEl = rootEl;
            selectors.iframeContainer = rootEl.querySelector(".iframe-container");
            selectors.iframe = rootEl.querySelector("iframe");
            selectors.registeredCc = rootEl.querySelector(".cc-registered-row");
            selectors.saveCc = rootEl.querySelector(".save-cc");
            selectors.oneClickCheckbox = rootEl.querySelector('[name="payment[create_oneclick]"]');
            selectors.notice = rootEl.querySelector(".notice");
            selectors.noticeMessage = rootEl.querySelector(".notice-message");
            selectors.continueWrapper = rootEl.querySelector(".iframe-continue");
            selectors.continueBtn = selectors.continueWrapper
                ? selectors.continueWrapper.querySelector("button")
                : null;
            selectors.fingerPrintInput = rootEl.querySelector("#ioBB");
            selectors.iframeWrapper = rootEl.querySelector(".iframe-wrapper");
            selectors.hiddenFingerprint = rootEl.querySelector("#hosted-ioBBFingerPrint");
        }

        // Read the payment configuration payload from serialized storefront config.
        function initializeComponentFromConfig() {
            const hiPayFullservice = hiPayGeneralConfig?.payment?.hiPayFullservice;
            if (!hiPayFullservice) return;

            component.afterPlaceOrderUrl = hiPayFullservice.afterPlaceOrderUrl?.[methodCode] || "";
            component.customerCards = hiPayFullservice.customerCards || [];
            component.isIframeMode = hiPayFullservice.isIframeMode?.[methodCode] || "";
            component.iframeWidth = hiPayFullservice.iFrameWidth?.[methodCode] || "";
            component.iframeHeight = hiPayFullservice.iFrameHeight?.[methodCode] || "";
            component.iframeStyle = hiPayFullservice.iFrameStyle?.[methodCode] || "";
            component.iframeWrapperStyle = hiPayFullservice.iFrameWrapperStyle?.[methodCode] || "";
            component.useOneClick = hiPayFullservice.useOneclick?.hipay_hosted || false;
            component.locale = hiPayFullservice.locale?.[methodCode] || "";
        }

        // Create the HiPay SDK client scoped to this payment method settings.
        function initHipaySdk() {
            let lang = "en";
            if (component.locale && component.locale.length > 2) {
                lang = component.locale.substr(0, 2);
            }

            window.hipaySdk = new HiPay({
                username: component.apiUsernameTokenJs,
                password: component.apiPasswordTokenJs,
                environment: component.env,
                lang: lang
            });
        }

        // Return the device fingerprint generated by the anti-fraud script.
        function setFingerprint() {
            if (selectors.fingerPrintInput) {
                return selectors.fingerPrintInput.value;
            }
            return "";
        }

        // Apply merchant-provided iframe style and dimensions.
        function setIframe() {
            if (!selectors.iframeWrapper || !selectors.iframe) return;
            selectors.iframeWrapper.style = component.iframeWrapperStyle;
            selectors.iframe.style = component.iframeStyle;
            selectors.iframe.style.width = component.iframeWidth;
            selectors.iframe.style.height = component.iframeHeight;
        }

        // Build payment data and trigger order placement for Hosted mode.
        async function placePendingPaymentOrder() {
            const isValid = await hyvaCheckout.validation.validate();
            if (!isValid) return;

            const customerCardIsSelected = await Magewire.find(wireId).get("customerCardIsSelected");
            const isIframeMode = !!component.isIframeMode;
            const afterPlaceOrderUrl = component.afterPlaceOrderUrl;
            if (!isIframeMode && !customerCardIsSelected) {
                const paymentData = {
                    additionalData: {
                        create_oneclick: component.createOneclick,
                        eci: hiPayGeneralConfig?.payment?.hiPayFullservice?.defaultEci,
                        redirectUrl: afterPlaceOrderUrl
                    }
                };

                Magewire.find(wireId)
                    .call("setPaymentData", paymentData)
                    .then(() => {
                        hyvaCheckout.main.getWireComponent().placeOrder();
                    });

                return;
            }

            let fingerprint = "";
            const ioBB = document.getElementById("ioBB");
            const ioBBCard = document.getElementById("ioBBCard");

            if (ioBB && ioBB.value) fingerprint = ioBB.value;
            if (ioBBCard && ioBBCard.value !== "") fingerprint = ioBBCard.value;

            if (customerCardIsSelected) {
                const selectedCustomerCard = await Magewire.find(wireId).get("selectedCustomerCard");
                const card = (component.customerCards || [])[selectedCustomerCard] || {};
                const ccOwner = card.ccOwner;
                const ccToken = card.ccToken;
                const ccType = card.ccType;

                const paymentData = {
                    ccType: ccType,
                    additionalData: {
                        create_oneclick: false,
                        card_token: ccToken,
                        can_redirect: true,
                        eci: hiPayGeneralConfig?.payment?.hiPayFullservice?.recurringEci,
                        cc_type: ccType,
                        fingerprint: fingerprint,
                        cc_cid: "",
                        cc_ss_start_month: "",
                        cc_ss_start_year: "",
                        cc_exp_year: "",
                        cc_exp_month: "",
                        cc_number: "",
                        cc_owner: ccOwner,
                        browser_info: JSON.stringify(window.hipaySdk.getBrowserInfo())
                    }
                };

                Magewire.find(wireId)
                    .call("setPaymentData", paymentData)
                    .then(() => {
                        hyvaCheckout.main.getWireComponent().placeOrder();
                    });

            } else {
                const paymentData = {
                    additionalData: {
                        card_multi_use: component.createOneclick,
                        eci: hiPayGeneralConfig?.payment?.hiPayFullservice?.defaultEci,
                        fingerprint: fingerprint
                    }
                };

                Magewire.find(wireId)
                    .call("setPaymentData", paymentData)
                    .then(() => {
                        hyvaCheckout.main.getWireComponent()
                            .placeOrder()
                            .then(() => {
                                if (selectors.iframeContainer) selectors.iframeContainer.style.display = "block";
                                if (selectors.notice) selectors.notice.style.display = "block";
                                if (selectors.continueWrapper) selectors.continueWrapper.style.display = "none";

                                component.isInAction = true;

                                if (selectors.iframe) {
                                    selectors.iframe.src = afterPlaceOrderUrl;
                                }
                            });
                    });
            }
        }

        /**
         * Initialize the hosted container UI.
         */
        function initializeUi() {
            const root = document.getElementById("hipay-container-hosted");
            if (!root) return;

            initSelectors(root);
            initializeComponentFromConfig();

            if (selectors.oneClickCheckbox) {
                selectors.oneClickCheckbox.addEventListener("change", (event) => {
                    component.createOneclick = !!event.currentTarget.checked;
                });
            }

            if (!window.hipaySdk) {
                initHipaySdk();
            }

            if (component.isIframeMode) {
                setIframe();
            } else if (selectors.noticeMessage) {
                selectors.noticeMessage.classList.remove("hidden");
            }

            if (selectors.continueBtn) {
                selectors.continueBtn.addEventListener("click", () => placePendingPaymentOrder());
            }

            if (selectors.hiddenFingerprint) {
                selectors.hiddenFingerprint.value = setFingerprint();
            }

            const placeOrderBtn = document.querySelector(".btn-place-order");
            if (placeOrderBtn) {
                placeOrderBtn.setAttribute("disabled", "disabled");
            }
        }

        /**
         * Register the payment method lifecycle with Hyvä Checkout once.
         */
        function registerWithHyva() {
            const root = document.getElementById("hipay-container-hosted");
            if (!root) return;

            if (hyvaRegistered) {
                initializeUi();
                return;
            }

            const existingMethod = hyvaCheckout.payment.getByCode(methodCode);
            if (existingMethod) {
                existingMethod.hiPayGeneralConfig = hiPayGeneralConfig;
                existingMethod.hiPayCcConfig = hiPayCcConfig;
                existingMethod.selectors = selectors;
                existingMethod.component = component;
                existingMethod.initialize = async function () {
                    initializeUi();
                };
                existingMethod.uninitialize = async function () {
                    onDeactivate();
                };
                existingMethod.placeOrderViaJs = function () {
                    return true;
                };
                existingMethod.placeOrder = async function () {
                    return placePendingPaymentOrder();
                };
                existingMethod.placePendingPaymentOrder = async function () {
                    return placePendingPaymentOrder();
                };

                hyvaRegistered = true;
                initializeUi();
                return;
            }

            hyvaRegistered = true;

            hyvaCheckout.payment.registerMethod({
                code: methodCode,
                method: {
                    hiPayGeneralConfig: hiPayGeneralConfig,
                    hiPayCcConfig: hiPayCcConfig,
                    selectors: selectors,
                    component: component,

                    async initialize() {
                        initializeUi();
                    },

                    async uninitialize() {
                        onDeactivate();
                    },

                    placeOrderViaJs() {
                        return true;
                    },

                    async placeOrder() {
                        return placePendingPaymentOrder();
                    },

                    async placePendingPaymentOrder() {
                        return placePendingPaymentOrder();
                    }
                }
            });

            initializeUi();
        }

        function onDeactivate() {
            component.isInAction = false;

            const placeOrderBtn = document.querySelector(".btn-place-order");
            if (placeOrderBtn) {
                placeOrderBtn.removeAttribute("disabled");
            }
        }

        return {
            init() {
                if (!window.hipayPaymentBus) return;

                window.hipayPaymentBus.register(methodCode, {
                    onActivate: registerWithHyva,
                    onDeactivate: onDeactivate
                });

                window.hipayPaymentBus.ensureActive(methodCode);
            }
        };
    }

    window.addEventListener(
        "alpine:init",
        () => Alpine.data("hipayCheckoutHosted", hipayCheckoutHosted),
        { once: true }
    );
</script>
<?php $hyvaCsp->registerInlineScript() ?>
