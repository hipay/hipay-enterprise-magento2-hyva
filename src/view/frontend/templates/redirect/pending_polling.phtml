use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;

/** @var \HiPay\FullserviceMagento\Block\Redirect\PendingPolling $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<div class="page-title">
    <h1><?= $escaper->escapeHtml(__('Your payment is in pending.')) ?></h1>
</div>

<?php if ($block->getRealOrderId()): ?>
    <p><?= $escaper->escapeHtml(__('Order #')) ?> <?= $escaper->escapeHtml((string) $block->getRealOrderId()) ?></p>
<?php endif; ?>

<?php if ($error = $block->getErrorMessage()): ?>
    <p><?= $escaper->escapeHtml($error) ?></p>
<?php endif; ?>

<p>
    <?= $escaper->escapeHtml(
        __('Click <a href="%1">here</a> to continue shopping.', $escaper->escapeUrl($block->getContinueShoppingUrl())),
        ['a']
    ) ?>
</p>

<script>
    "use strict";

    // Generic pending-payment poller: follows the redirectUrl returned by the
    // shared status endpoint. Method-agnostic (Bizum, BancomatPay, ...).
    (function () {
        var attempts = 0;
        var maxAttempts = <?= (int) $block->getPollingMaxAttempts() ?>;
        var pollInterval = <?= (int) $block->getPollingInterval() ?>;
        var pendingUrl = "<?= $escaper->escapeJs($block->getPendingUrl()) ?>";
        var declineUrl = "<?= $escaper->escapeJs($block->getDeclineUrl()) ?>";
        var statusUrl = "<?= $escaper->escapeJs($block->getPlaceOrderStatusUrl()) ?>";

        function goToDecline() {
            window.clearInterval(timer);
            window.location.assign(declineUrl);
        }

        var timer = window.setInterval(function () {
            attempts++;

            fetch(statusUrl, {
                credentials: "same-origin",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (data && data.redirectUrl && data.redirectUrl !== pendingUrl) {
                        window.clearInterval(timer);
                        window.location.assign(data.redirectUrl);
                        return;
                    }
                    if (attempts >= maxAttempts) {
                        goToDecline();
                    }
                })
                .catch(function () {
                    if (attempts >= maxAttempts) {
                        goToDecline();
                    }
                });
        }, pollInterval);
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
